# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here
LANGSMITH_API_KEY=YOUR-API-KEY
LANGSMITH_TRACING=true

# DeepSeek(文本:Solver / Reviewer / 软分流共用)
DEEPSEEK_API_KEY=YOUR-API-KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com

# VLM(视觉:识题)
SILICONFLOW_API_KEY=YOUR-API-KEY
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 模型名(可选,config.py 里有默认值,想覆盖才填)
MODEL_SOLVER=deepseek-chat
MODEL_VLM=Qwen/Qwen3-VL-8B-Instruct